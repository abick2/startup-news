{
  "name": "startup-news-sender",
  "version": "1.0.0",
  "description": "Daily startup news digest: Claude Agent SDK research, Resend delivery",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "preview": "tsx src/index.ts --fixture --dry-run",
    "digest:dry": "tsx src/index.ts --dry-run"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.12"
  }
}
