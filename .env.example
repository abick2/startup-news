# Claude Console API key: https://platform.claude.com/
ANTHROPIC_API_KEY=

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=

# Where the digest goes. With the shared onboarding@resend.dev sender, this must
# be the email address on your Resend account.
EMAIL_TO=

# Switch this to an address on your own domain once it's verified in Resend.
EMAIL_FROM="The Startup Brief <onboarding@resend.dev>"

# Optional overrides
# MODEL=claude-haiku-5-5
# MAX_BUDGET_USD=2
# TIMEZONE=America/New_York
